# Copy this file to .env and fill in real values (don't commit .env to GitHub)

# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# Same Client ID used for Elyndrix's Google Sign-In. Make sure your Vexkly domain
# (e.g. https://vexkly.onrender.com) is added under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Any long random string, used to sign session cookies
SESSION_SECRET=change-this-to-a-long-random-string

NODE_ENV=production
